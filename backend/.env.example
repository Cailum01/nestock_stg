# Copy to backend/.env and fill in. Never commit backend/.env.

# -----------------------------------------------------------------------------
# Vertex AI: Agent, vision, and speech (ADC; no API keys or service-account JSON)
# -----------------------------------------------------------------------------
# Application Default Credentials provide authentication. These are references only.
NESTOCK_VERTEX_PROJECT_ID=
# Alternative project input when supplied by the host environment:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
NESTOCK_VERTEX_LOCATION=us-central1
# Allowed: gemini-3.8-flash (default) or gemini-3.8-flash (operator-selected).
NESTOCK_VERTEX_MODEL=gemini-3.8-flash

# -----------------------------------------------------------------------------
# Legacy Azure model settings (not selected by the current Vertex adapters)
# -----------------------------------------------------------------------------
# Retained for the legacy Azure adapter only; these do not configure Agent or vision.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# 選填: 設為 1 時購買卡會帶使用者說的購買日期（「昨天買的」），只給本機測試用；
# 雲端不設，照樣關著（contracts/approval-lifecycle.md 第 11 節）。
NESTOCK_DATED_PURCHASES=0

# -----------------------------------------------------------------------------
# Legacy Azure Vision settings (not selected by the current Vertex adapter)
# -----------------------------------------------------------------------------
AZURE_OPENAI_VISION_DEPLOYMENT=
# Optional legacy Azure endpoint/key overrides.
# AZURE_OPENAI_VISION_ENDPOINT=
# AZURE_OPENAI_VISION_API_KEY=
# Optional legacy Azure vision temperature.
# AZURE_OPENAI_VISION_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# Legacy Azure AI Speech settings (not used by the current Vertex speech factory)
# -----------------------------------------------------------------------------
# These values do not configure speech; use Vertex ADC settings above.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
# 選填: Azure AI Foundry / Azure AI Services 自訂端點（若未填寫則預設使用區域端點）
AZURE_SPEECH_ENDPOINT=
# 選填: 本機離線開發或畫面測試開關。設為 1 時無金鑰亦強制啟用 Mock 語音服務
NESTOCK_SPEECH_MOCK=0

# -----------------------------------------------------------------------------
# A2: 比價與商品搜尋 (BigGo Search API & Price Comparison)
# -----------------------------------------------------------------------------
# Generate from https://account.biggo.com/setting/token
BIGGO_CLIENT_ID=
BIGGO_CLIENT_SECRET=

# A2: Backup commerce provider (Google Shopping via SerpApi)
# -----------------------------------------------------------------------------
# Generate from https://serpapi.com/manage-api-key
# If unset or unavailable, BigGo failures fall through to clearly labelled demo data.
SERPAPI_API_KEY=

# -----------------------------------------------------------------------------
# A2 / Shared: 本機暫存影像上傳設定 (Provisional Staging Storage)
# -----------------------------------------------------------------------------
# 本機行動裝置開發可明確設定可達的固定上傳網址；不從 Host/Forwarded headers 推導。
# GCS/STG 必須設定固定 HTTPS URL，且路徑為 /staging/upload。
# NESTOCK_STAGING_BASE_URL=https://api.example.test/staging/upload

# -----------------------------------------------------------------------------
# DEV/Azure opt-in example only (not the STG data provider): Cosmos DB NoSQL.
# Uncomment and fill these only for an explicitly intended local Azure DEV setup.
# -----------------------------------------------------------------------------
# NESTOCK_DATA_PROVIDER=cosmos
# NESTOCK_COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
# NESTOCK_COSMOS_DATABASE=nestock
# NESTOCK_COSMOS_CONTAINER=household-data

# -----------------------------------------------------------------------------
# STG choice: GCP Firestore + GCS (Application Default Credentials)
# -----------------------------------------------------------------------------
# STG must explicitly select Firestore + GCS. Firestore never falls back to local
# or Azure media; startup fails if GCS is not explicitly selected/configured.
# Do not enable the DEV/Azure examples in this template.
# Authentication uses Application Default Credentials; never add service-account keys.
# NESTOCK_DATA_PROVIDER=firestore
# NESTOCK_MEDIA_PROVIDER=gcs
# NESTOCK_FIRESTORE_PROJECT_ID=your-project-id
# NESTOCK_FIRESTORE_DATABASE=(default)
# SHA-256 hashes of high-entropy one-use bootstrap challenges, comma-separated.
# Store the preimages securely outside this repository; no plaintext is accepted here.
# NESTOCK_BOOTSTRAP_CHALLENGE_HASHES=
# Google OAuth audience and comma-separated operator ID-token subject allowlist.
# Keep the allowlist limited to trusted operator subjects; never put credentials here.
# NESTOCK_BOOTSTRAP_ISSUER_AUDIENCE=
# NESTOCK_BOOTSTRAP_OPERATOR_SUBJECTS=
# NESTOCK_GCS_PROJECT_ID=your-project-id
# NESTOCK_GCS_BUCKET=private-regional-bucket

# Required least-privilege service identity:
# - Firestore custom role: datastore.databases.get/getMetadata,
#   datastore.entities.get/list/create/update/delete; scope to this database.
# - GCS custom role: storage.buckets.get and storage.objects.get/list/create/
#   update/delete; grant on this bucket only. No signing or public ACL permissions.
# The bucket must enforce uniform bucket-level access and public access prevention.
# No GCP resources are created by this application.

# -----------------------------------------------------------------------------
# DEV/Azure opt-in example only (not the STG media provider): Azure Blob Storage.
# Azure media is used only when NESTOCK_MEDIA_PROVIDER=azure is explicit.
# Uncomment and fill these only for an explicitly intended local Azure DEV setup.
# -----------------------------------------------------------------------------
# NESTOCK_MEDIA_PROVIDER=azure
# AZURE_STORAGE_BLOB_ENDPOINT=https://<your-storage-account>.blob.core.windows.net/
# AZURE_STORAGE_CONTAINER_NAME=media
# AZURE_STORAGE_CONNECTION_STRING=