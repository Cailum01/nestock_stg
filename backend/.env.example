# Copy to backend/.env and fill in. Never commit backend/.env.

# -----------------------------------------------------------------------------
# A1: Agent 對話與決策大腦 (Azure OpenAI)
# -----------------------------------------------------------------------------
# Foundry -> 模型 -> your deployment -> 詳細資料.
# Agent stays disabled (POST /agent/messages returns 501) until all three are set.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# -----------------------------------------------------------------------------
# A2: 視覺多模態感測與辨識 (Azure AI Foundry / OpenAI Vision)
# -----------------------------------------------------------------------------
# 現行高 CP 值主流多模態模型推薦：
# 若未設定此項，系統自動沿用 A1 的 AZURE_OPENAI_DEPLOYMENT
AZURE_OPENAI_VISION_DEPLOYMENT=
# 選填: 若視覺模型部署於不同的 Azure 資源或獨立端點時填寫
# AZURE_OPENAI_VISION_ENDPOINT=
# AZURE_OPENAI_VISION_API_KEY=

# -----------------------------------------------------------------------------
# A2: 語音轉文字 (Azure AI Speech Fast Transcription)
# -----------------------------------------------------------------------------
# 注意：目前 dependencies.py 的語音固定使用示範服務 (MockSpeechToTextService)，
# 填寫以下金鑰暫時不會生效，待後續接線時啟用。
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# -----------------------------------------------------------------------------
# A2: 比價與商品搜尋 (BigGo Search API & Price Comparison)
# -----------------------------------------------------------------------------
# Generate from https://account.biggo.com/setting/token
BIGGO_CLIENT_ID=
BIGGO_CLIENT_SECRET=
