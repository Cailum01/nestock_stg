  },
  {
    "id": "TC_SPEECH_013",
    "text": "胃藥放在客廳茶几右下角"
  },
  {
    "id": "TC_SPEECH_014",
    "text": "我的手電筒收在玄關總開關箱旁邊"
  },
  {
    "id": "TC_SPEECH_015",
    "text": "酒精噴霧放進客廳門口置物籃"
  },
  {
    "id": "TC_SPEECH_016",
    "text": "封箱膠帶放在客廳儲藏室 2 號箱"
  },
  {
    "id": "TC_SPEECH_017",
    "text": "吹風機放在浴室鏡櫃第二層"
  },
  {
    "id": "TC_SPEECH_018",
    "text": "指甲剪收在客廳電視櫃第一個小抽屜"
  },
  {
    "id": "TC_SPEECH_019",
    "text": "聽說今天天氣很好"
  },
  {
    "id": "TC_SPEECH_020",
    "text": "我把東西放好了"
  }
