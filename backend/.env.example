# Copy to backend/.env and fill in. Never commit backend/.env.
# Foundry -> 模型 -> your deployment -> 詳細資料.
# Agent stays disabled (POST /agent/messages returns 501) until all three are set.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
