[
  {
    "id": "TC_SPEECH_001",
    "text": "我把護照放在主臥室右邊第一個抽屜"
  },
  {
    "id": "TC_SPEECH_002",
    "text": "備用鑰匙收在玄關鞋櫃最上面的小盒子"
  },
  {
    "id": "TC_SPEECH_003",
    "text": "把電鑽放進一號箱裡面"
  },
  {
    "id": "TC_SPEECH_004",
    "text": "幫我記一下，螺絲起子收在客廳儲藏室 2 號箱"
  },
  {
    "id": "TC_SPEECH_005",
    "text": "那個感冒藥我擺在廚房中島第二個抽屜"
  },
  {
    "id": "TC_SPEECH_006",
    "text": "冬天的厚棉被收進衣帽間上層大整理箱"
