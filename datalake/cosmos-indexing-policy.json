{
  "indexingMode": "consistent",
  "automatic": true,
  "includedPaths": [
    {
      "path": "/*"
    }
  ],
  "excludedPaths": [
    {
      "path": "/\"_etag\"/?"
    }
  ],
  "compositeIndexes": [
    [
      {
        "path": "/created_at",
        "order": "descending"
      },
      {
        "path": "/transaction_id",
        "order": "ascending"
      }
    ],
    [
      {
        "path": "/next_attempt_at",
        "order": "ascending"
      },
      {
        "path": "/created_at",
        "order": "ascending"
      }
    ]
  ]
}
